{
  "name": "lab-transient-vdc-parallel-c（5V 电压源直接并电容和电阻，电容不带初值：全程 5V。电容初值曾被当成元件缺省值，这个电路因此 InitialFailure）",
  "endpoint": "simulate",
  "request": {
    "components": [
      {
        "id": "V1",
        "type": "vsource_dc",
        "parameters": {
          "dc": 5.0
        },
        "connections": {
          "pos": "a",
          "neg": "gnd"
        }
      },
      {
        "id": "C1",
        "type": "capacitor",
        "parameters": {
          "value": 1e-06
        },
        "connections": {
          "p": "a",
          "n": "gnd"
        }
      },
      {
        "id": "R1",
        "type": "resistor",
        "parameters": {
          "value": 1000.0
        },
        "connections": {
          "p": "a",
          "n": "gnd"
        }
      },
      {
        "id": "G1",
        "type": "ground",
        "parameters": {},
        "connections": {
          "gnd": "gnd"
        }
      },
      {
        "id": "VP1",
        "type": "voltage_probe",
        "parameters": {},
        "connections": {
          "node": "a"
        }
      }
    ],
    "nets": [
      {
        "name": "a",
        "nodes": [
          [
            "V1",
            "pos"
          ],
          [
            "C1",
            "p"
          ],
          [
            "R1",
            "p"
          ],
          [
            "VP1",
            "node"
          ]
        ]
      },
      {
        "name": "gnd",
        "nodes": [
          [
            "V1",
            "neg"
          ],
          [
            "C1",
            "n"
          ],
          [
            "R1",
            "n"
          ],
          [
            "G1",
            "gnd"
          ]
        ]
      }
    ],
    "sim": {
      "t_stop": 0.005,
      "n_samples": 51
    }
  },
  "expect": [
    {
      "path": "status",
      "equals": "ok"
    },
    {
      "path": "data.signals.1.values.1",
      "approx": 5.0,
      "atol": 1e-06
    },
    {
      "path": "data.signals.1.values.-1",
      "approx": 5.0,
      "atol": 1e-06
    }
  ]
}
