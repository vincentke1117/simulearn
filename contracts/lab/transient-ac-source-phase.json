{
  "name": "lab-transient-ac-source-phase（初相 90°：10·sin(2π·50t + 90°) = 10·cos(2π·50t)，t=0 为 10V，5ms 为 0，10ms 为 −10V）",
  "endpoint": "simulate",
  "request": {
    "components": [
      { "id": "VAC1", "type": "vsource_ac", "parameters": { "amplitude": 10.0, "frequency": 50.0, "phase": 90.0 }, "connections": { "pos": "n1", "neg": "gnd" } },
      { "id": "R1", "type": "resistor", "parameters": { "value": 100.0 }, "connections": { "p": "n1", "n": "gnd" } },
      { "id": "G1", "type": "ground", "parameters": {}, "connections": { "gnd": "gnd" } },
      { "id": "VP1", "type": "voltage_probe", "parameters": {}, "connections": { "node": "n1" } }
    ],
    "nets": [
      { "name": "n1", "nodes": [["VAC1", "pos"], ["R1", "p"], ["VP1", "node"]] },
      { "name": "gnd", "nodes": [["VAC1", "neg"], ["R1", "n"], ["G1", "gnd"]] }
    ],
    "sim": { "t_stop": 0.02, "n_samples": 41 }
  },
  "expect": [
    { "path": "status", "equals": "ok" },
    { "path": "data.signals.1.values.1", "approx": 10.0, "atol": 1e-03 },
    { "path": "data.signals.1.values.11", "approx": 0.0, "atol": 1e-03 },
    { "path": "data.signals.1.values.21", "approx": -10.0, "atol": 1e-03 }
  ]
}
