{
  "name": "lab-dc-node-voltage-floating-divider（不接地：自动以 V1 负极为参考点，元件电压、电流与接地时相同）",
  "endpoint": "simulate",
  "request": {
    "components": [
      {
        "id": "V1",
        "type": "vsource_dc",
        "parameters": {
          "dc": 5.0
        },
        "connections": {
          "pos": "n1",
          "neg": "n3"
        }
      },
      {
        "id": "R1",
        "type": "resistor",
        "parameters": {
          "value": 1000.0
        },
        "connections": {
          "p": "n1",
          "n": "n2"
        }
      },
      {
        "id": "R2",
        "type": "resistor",
        "parameters": {
          "value": 1000.0
        },
        "connections": {
          "p": "n2",
          "n": "n3"
        }
      },
      {
        "id": "VP1",
        "type": "voltage_probe",
        "parameters": {},
        "connections": {
          "node": "n2"
        }
      }
    ],
    "nets": [
      {
        "name": "n1",
        "nodes": [
          [
            "V1",
            "pos"
          ],
          [
            "R1",
            "p"
          ]
        ]
      },
      {
        "name": "n2",
        "nodes": [
          [
            "R1",
            "n"
          ],
          [
            "R2",
            "p"
          ],
          [
            "VP1",
            "node"
          ]
        ]
      },
      {
        "name": "n3",
        "nodes": [
          [
            "R2",
            "n"
          ],
          [
            "V1",
            "neg"
          ]
        ]
      }
    ],
    "sim": {
      "t_stop": 0.001,
      "n_samples": 10
    },
    "method": "node_voltage"
  },
  "expect": [
    {
      "path": "status",
      "equals": "ok"
    },
    {
      "path": "data.node_voltages.n1",
      "approx": 5.0,
      "atol": 1e-09
    },
    {
      "path": "data.node_voltages.n2",
      "approx": 2.5,
      "atol": 1e-09
    },
    {
      "path": "data.node_voltages.n3",
      "approx": 0.0,
      "atol": 1e-12
    },
    {
      "path": "data.branch_currents.R1",
      "approx": 0.0025,
      "atol": 1e-09
    },
    {
      "path": "data.branch_currents.V1",
      "approx": -0.0025,
      "atol": 1e-09
    },
    {
      "path": "data.reference.1.net",
      "equals": "n3"
    },
    {
      "path": "data.reference.1.component",
      "equals": "V1"
    },
    {
      "path": "data.reference.1.terminal",
      "equals": "neg"
    }
  ]
}
