{
  "name": "simulearn-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:lab",
    "dev:lab": "npm run dev -w @simulearn/lab-web",
    "dev:legacy": "vite",
    "build": "npm run build:lab && npm run build:grid",
    "build:lab": "npm run build -w @simulearn/lab-web",
    "build:grid": "npm run build -w @simulearn/grid-web",
    "build:legacy": "vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "npm run preview -w @simulearn/lab-web",
    "preview:grid": "npm run preview -w @simulearn/grid-web",
    "preview:legacy": "vite preview",
    "lint": "npm run lint -w @simulearn/lab-web && npm run lint -w @simulearn/grid-web",
    "lint:legacy": "eslint \"src/**/*.{ts,tsx}\" --config config/eslint.config.js",
    "typecheck:lab": "npm run typecheck -w @simulearn/lab-web",
    "test:lab": "npm run test -w @simulearn/lab-web -- run",
    "check": "npm run typecheck:lab && npm run test:lab && npm run typecheck:grid && npm run test:grid",
    "typecheck:grid": "npm run typecheck -w @simulearn/grid-web",
    "test:grid": "npm run test -w @simulearn/grid-web"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.3",
    "@tanstack/react-query": "^5.51.21",
    "antd": "^5.18.1",
    "axios": "^1.16.0",
    "react-redux": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12"
  }
}
