# SimuLearn 统一网关（本机单用户）
# 启动：在仓库根目录运行 gateway/bin/caddy.exe run --config gateway/Caddyfile
# 路径约定：/           → 静态首页（gateway/site）
#           /circuit/*  → 电路实验室（lab-web 构建产物）
#           /grid/*     → 配电网实验室（grid-web 构建产物）
#           /api/lab/*  → JCircuitServer（8080，前缀剥离：/api/lab/simulate → /simulate）
#           /api/grid/* → JGDO/Oxygen（8123，前缀透传：后端路由本身就是 /api/grid/*）
{
	auto_https off
	admin off
}

http://127.0.0.1:8100 {
	# 站点地址只决定匹配哪个 Host，不限制监听哪块网卡；不写 bind 时 Caddy 监听 0.0.0.0，
	# 局域网里的机器伪造 Host 头就能借网关（它会注入令牌）调用两个内核（设计记录 D17）。
	bind 127.0.0.1
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	# 两个内核只认带令牌的请求（设计记录 D17）：令牌由 start-all 每次启动生成，经环境变量传进来，
	# 在这里注入；页面拿不到。没设置时退回开发令牌，只供本机手工调试。
	handle /api/grid/* {
		reverse_proxy 127.0.0.1:8123 {
			header_up X-Zhifan-Ext-Token {$SIMULEARN_TOKEN:simulearn-dev}
		}
	}

	handle_path /api/lab/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Zhifan-Ext-Token {$SIMULEARN_TOKEN:simulearn-dev}
		}
	}

	redir /grid /grid/ 308
	redir /circuit /circuit/ 308

	handle_path /grid/* {
		root * packages/grid-web/dist
		file_server
	}

	# lab-web 用 BrowserRouter（真实路径 /circuit/editor），刷新时需要 SPA 回退到 index.html。
	# grid-web 用 hash 路由（/grid/#/editor），不需要回退。
	handle_path /circuit/* {
		root * packages/lab-web/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		root * gateway/site
		file_server
	}
}
